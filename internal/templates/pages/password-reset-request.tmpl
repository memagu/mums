{{ define "password-reset-request" }}
    {{ template "base" . }}
{{ end }}

{{ define "title" }}mums | Password Reset{{ end }}

{{ define "content" }}
    <div class="self-center max-w-full flex flex-col items-center gap-12 mb-24">
        <h1 class="flex flex-col items-center gap-4 text-2xl">
            <img src="/static/icons/mums.svg" alt="Logo" class="size-24" />
            <span>Honey? Where's my password‽</span>
        </h1>

        <form hx-post="/password-reset" hx-target="#form-fields" hx-swap="outerHTML" class="flex flex-col gap-6">
            {{ template "fragment-form-fields" . }}
        </form>
    </div>
{{ end }}

{{ define "fragment-form-fields" }}
    <div id="form-fields" class="flex flex-col gap-6">
        {{ if .Sent }}
            <p class="text-center text-sm text-backdrop-content-muted">If the account exists, a reset link is on its way.</p>
            {{ if .Fallback }}
                <p class="text-center text-xs text-backdrop-content-muted">This server prints reset links to its log — email sending isn't configured.</p>
            {{ end }}
            <p class="text-center text-sm text-backdrop-content-muted">
                <a href="/login" class="text-backdrop-content-highlight hover:underline">Remember your password?</a>
            </p>
        {{ else }}
            {{ template "component-form-input-field" dict
                "ID" "email-field"
                "Label" "Email address"
                "Name" "email"
                "Type" "email"
                "Autocomplete" "email"
                "Required" true
                "Value" .Email
                "Errors" .Errors.Email
            }}
            {{ template "component-generic-errors" . }}
            {{ template "component-primary-button" dict "Text" "Send reset link" }}
            <p class="text-center text-sm text-backdrop-content-muted">
                <a href="/login" class="text-backdrop-content-highlight hover:underline">Remember your password?</a>
            </p>
        {{ end }}
    </div>
{{ end }}
