{{ define "phaddergrupp-settings" }}
    {{ template "base" . }}
{{ end }}

{{ define "title" }}mums | Phaddergrupp Settings{{ end }}

{{ define "head" }}
    {{ template "import-toastr" . }}
{{ end }}

{{ define "content" }}
    <div class="self-center max-w-full flex flex-col justify-center gap-6">
        <h1 class="text-center text-2xl text-backdrop-content">
            Fine-tuning
            <span class="inline-block max-w-full align-bottom truncate whitespace-nowrap border-b-2 border-[{{ .PrimaryColor }}] -mb-[2px]">
                {{- .Name -}}
            </span>
            vibes!
        </h1>

        <form
            hx-patch="/phaddergrupp/{{ .PhaddergruppID }}/settings"
            hx-target="#form-fields"
            hx-swap="outerHTML"
            class="flex flex-col gap-6"
            hx-on::after-on-load="
                toastr.options.timeOut = 2000;
                toastr.options.positionClass = 'toast-top-center';
                toastr.options.progressBar = true;
                if (event.detail.xhr.status === 200) {
                    toastr.success('Settings saved');
                } else if (event.detail.xhr.status >= 500) {
                    toastr.error('Failed to save settings');
                }
            "
        >
            {{ template "fragment-form-fields" . }}
            <button type="submit" class="w-full bg-[{{ .PrimaryColor }}] text-brand-primary-content py-2 rounded-md text-lg font-semibold hover:bg-[{{ .SecondaryColor }}] active:bg-[{{ .SecondaryColor }}]">Save</button>
        </form>

        <a
            href="/phaddergrupp/{{ .PhaddergruppID }}"
            class="w-full bg-[{{ .PrimaryColor }}] text-brand-primary-content text-center px-6 py-2
                   rounded-md text-lg font-semibold hover:bg-[{{ .SecondaryColor }}]
                   active:bg-[{{ .SecondaryColor }}] truncate"
        >󰌑 Return to {{ .Name }}</a>

        {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

        <h2 class="text-center text-xl font-semibold text-backdrop-content">Members</h2>
        <ul class="flex flex-col gap-2 w-full">
            {{ range .Members }}
                <li
                    id="settings-member-row-{{ .UserAccountID }}"
                    class="flex items-center justify-between p-3 bg-card rounded-xl text-card-content"
                >
                    <div class="flex items-center gap-2 min-w-0">
                        {{ if eq (printf "%v" .PhaddergruppRole) "phadder" }}
                            <img src="/static/icons/student-cap.svg" alt="" aria-hidden="true" class="size-4 shrink-0" />
                        {{ else }}
                            <img src="/static/icons/cap.svg" alt="" aria-hidden="true" class="size-4 shrink-0" />
                        {{ end }}
                        <span class="truncate">{{ .UserProfileName }}</span>
                    </div>
                    <button
                        hx-post="/phaddergrupp/{{ $.PhaddergruppID }}/kick?user-account-id={{ .UserAccountID }}"
                        hx-confirm="Are you sure you want to kick {{ .UserProfileName }}?"
                        hx-swap="delete"
                        hx-target="#settings-member-row-{{ .UserAccountID }}"
                        class="shrink-0 rounded-full px-4 py-1 bg-error border-2 border-dashed border-error-border shadow-lg hover:bg-error-highlight active:bg-error-highlight"
                        title="Kick user from phaddergrupp"
                        aria-label="Kick {{ .UserProfileName }} from phaddergrupp"
                    >
                        <img src="/static/icons/kick.svg" alt="Kick user" class="size-5 invert" />
                    </button>
                </li>
            {{ end }}
        </ul>

        {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

        <button
            hx-delete="/phaddergrupp/{{ .PhaddergruppID }}"
            hx-confirm="Are you sure you want to delete {{ .Name }}?"
            class="w-full py-2 rounded-md text-lg text-error-content font-semibold bg-error
                   border-2 border-dashed border-error-border shadow-lg hover:bg-error-highlight
                   active:bg-error-highlight"
        >Delete phaddergrupp</button>
    </div>
{{ end }}

{{ define "fragment-form-fields" }}
    <div id="form-fields" class="grid grid-cols-1 sm:grid-cols-2 sm:grid-flow-col sm:grid-rows-7 sm:gap-x-6 gap-y-6">
        {{ template "component-form-input-field" dict
            "ID" "name-field"
            "Label" "Phaddergrupp name"
            "InfoLabel" "Shown on cards and the group page"
            "Name" "name"
            "Type" "text"
            "Required" true
            "Value" .Name
        }}
        {{ template "component-form-input-field" dict
            "ID" "swish-recipient-number-field"
            "Label" "Swish recipient's number"
            "InfoLabel" "Format example: 0704201337"
            "Name" "swish-recipient-number"
            "Type" "tel"
            "Pattern" .SwishRecipientNumberPattern
            "Required" true
            "Value" .SwishRecipientNumber
            "Errors" .Errors.SwishRecipientNumber
        }}
        {{ template "component-form-input-field" dict
            "ID" "primary-color-field"
            "Label" "Primary color"
            "InfoLabel" "Main color across the group"
            "Name" "primary-color"
            "Type" "color"
            "Class" "h-11"
            "Required" true
            "Value" .PrimaryColor
            "Errors" .Errors.PrimaryColor
        }}
        {{ template "component-form-input-field" dict
            "ID" "secondary-color-field"
            "Label" "Secondary color"
            "InfoLabel" "Hover and accent color"
            "Name" "secondary-color"
            "Type" "color"
            "Class" "h-11"
            "Required" true
            "Value" .SecondaryColor
            "Errors" .Errors.SecondaryColor
        }}
        {{ $currencyInfo := printf "Currency: %s" .MumsCurrency }}
        {{ template "component-form-input-field" dict
            "ID" "mums-price-n0lla-field"
            "Label" "Mums price (N0lla)"
            "InfoLabel" $currencyInfo
            "Name" "mums-price-n0lla"
            "Type" "number"
            "Min" 0
            "Step" 0.01
            "Required" true
            "Value" .MumsPriceN0lla
            "Errors" .Errors.MumsPriceN0lla
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-price-phadder-field"
            "Label" "Mums price (Phadder)"
            "InfoLabel" $currencyInfo
            "Name" "mums-price-phadder"
            "Type" "number"
            "Min" 0
            "Step" 0.01
            "Required" true
            "Value" .MumsPricePhadder
            "Errors" .Errors.MumsPricePhadder
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-capacity-per-user-field"
            "Label" "Mums capacity per user"
            "InfoLabel" "Mums a member can hold at once"
            "Name" "mums-capacity-per-user"
            "Type" "number"
            "Min" 0
            "Required" true
            "Value" .MumsCapacityPerUser
            "Errors" .Errors.MumsCapacityPerUser
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-min-purchase-quantity-field"
            "Label" "Mums min purchase quantity"
            "InfoLabel" "Lowest amount a member can buy"
            "Name" "mums-min-purchase-quantity"
            "Type" "number"
            "Min" 1
            "Required" true
            "Value" .MumsMinPurchaseQuantity
            "Errors" .Errors.MumsMinPurchaseQuantity
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-max-purchase-quantity-field"
            "Label" "Mums max purchase quantity"
            "InfoLabel" "Highest amount a member can buy"
            "Name" "mums-max-purchase-quantity"
            "Type" "number"
            "Min" 1
            "Required" true
            "Value" .MumsMaxPurchaseQuantity
            "Errors" .Errors.MumsMaxPurchaseQuantity
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-purchase-quantity-step-field"
            "Label" "Mums purchase step"
            "InfoLabel" "Buyable amounts increase by this"
            "Name" "mums-purchase-quantity-step"
            "Type" "number"
            "Min" 1
            "Required" true
            "Value" .MumsPurchaseQuantityStep
            "Errors" .Errors.MumsPurchaseQuantityStep
        }}
        {{ template "component-form-input-field" dict
            "ID" "mums-default-purchase-quantity-field"
            "Label" "Mums default purchase quantity"
            "InfoLabel" "Preselected amount when buying"
            "Name" "mums-default-purchase-quantity"
            "Type" "number"
            "Min" 1
            "Required" true
            "Value" .MumsDefaultPurchaseQuantity
            "Errors" .Errors.MumsDefaultPurchaseQuantity
        }}
        {{ template "component-form-select-field" dict
            "ID" "mums-recency-window-hours-field"
            "Label" "Mums recency window"
            "InfoLabel" "How far back member-card counts look"
            "Name" "mums-recency-window-hours"
            "Options" .RecencyWindowOptions
            "Selected" (.MumsRecencyWindowDuration.Hours | printf "%.0f")
            "Errors" .Errors.MumsRecencyWindowHours
        }}
        {{ template "component-form-select-field" dict
            "ID" "mums-pause-duration-field"
            "Label" "Mums pause duration"
            "InfoLabel" "How long a n0lla is paused for"
            "Name" "mums-pause-duration"
            "Options" .PauseDurationOptions
            "Selected" (.MumsPauseDuration.Minutes | printf "%.0f")
            "Errors" .Errors.MumsPauseDuration
        }}
        {{ template "component-generic-errors" . }}
    </div>
{{ end }}
