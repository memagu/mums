{{ define "phaddergrupp" }}
    {{ template "base" . }}
{{ end }}

{{ define "title" }}mums | Phaddergrupp{{ end }}

{{ define "head" }}
    {{ template "import-htmx-sse" . }}
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", (_) => {
            if (!document.querySelector(".mums-recency")) {
                return;
            }
            const relTime = (iso) => {
                const seconds = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
                if (seconds < 60) return seconds + "s";
                if (seconds < 3600) return Math.floor(seconds / 60) + "m";
                if (seconds < 86400) return Math.floor(seconds / 3600) + "h";
                if (seconds < 31536000) return Math.floor(seconds / 86400) + "d";
                return Math.floor(seconds / 31536000) + "y";
            };
            setInterval(() => {
                document.querySelectorAll(".mums-recency[data-last-mumsa]").forEach((el) => {
                    el.textContent = relTime(el.getAttribute("data-last-mumsa"));
                });
            }, 1000);
        });
    </script>
{{ end }}

{{ define "content" }}
    <div
        hx-ext="sse"
        sse-connect="/phaddergrupp/{{ .PhaddergruppID }}/event-stream"
        sse-swap="phaddergrupp-deleted,phaddergrupp-kicked"
        hx-swap="none"
        hx-on::sse-message="if (event.detail.type === 'phaddergrupp-deleted' || event.detail.type === 'phaddergrupp-kicked') { window.location = '/'; }"
        class="flex flex-col gap-6 w-full"
    >
        <div class="flex flex-col items-center gap-2 text-center w-full">
            {{ if .LogoFilePath.Valid }}
                <img src="{{ .LogoFilePath.String }}" alt="Logo" class="size-24" />
            {{ end }}

            <hgroup class="flex flex-col items-center gap-1 w-full">
                {{ template "fragment-group-name" . }}

                <p class="flex items-center gap-1.5 text-xl font-semibold text-backdrop-content-muted">
                    <span aria-hidden="true">-</span>
                    {{- if .IsPhadder }}
                        <img src="/static/icons/student-cap.svg" alt="" class="size-5" />
                        <span>Phadder</span>
                    {{ else }}
                        <img src="/static/icons/cap.svg" alt="" class="size-5" />
                        <span>N0lla</span>
                    {{ end -}}
                    <span aria-hidden="true">-</span>
                </p>
            </hgroup>

            <p class="max-w-full text-3xl break-words text-backdrop-content">
                {{ .UserProfileData.Name }}
            </p>
        </div>

        <div class="self-center max-w-full flex flex-col items-center gap-6">
            {{ if .IsPhadder }}
                {{ template "fragment-member-lists" . }}
            {{ else }}
                {{ template "fragment-mums-available-widget" . }}

                {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

                <button
                    hx-post="/phaddergrupp/{{ .PhaddergruppID }}/leave"
                    hx-confirm="Are you sure you want to leave this phaddergrupp?"
                    class="w-full py-2 rounded-md text-lg text-error-content font-semibold bg-error
                           border-2 border-dashed border-error-border shadow-lg hover:bg-error-highlight
                           active:bg-error-highlight"
                >Leave phaddergrupp</button>
            {{ end }}

            {{ if .IsPhadder }}
                {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

                <div class="w-full flex flex-col items-center gap-3">
                    {{ template "fragment-invite-link" dict
                        "ID" "invite-phadder"
                        "Label" "Invite Phaddrar"
                        "URL" .InviteURLPhadder
                    }}
                    {{ template "fragment-invite-link" dict
                        "ID" "invite-n0lla"
                        "Label" "Invite N0llor"
                        "URL" .InviteURLN0lla
                    }}
                </div>

                {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

                <a
                    href="/phaddergrupp/{{ .PhaddergruppID }}/settings"
                    class="w-full bg-[{{ .PrimaryColor }}] text-brand-primary-content text-center px-6 py-2 rounded-md text-lg font-semibold hover:bg-[{{ .SecondaryColor }}] active:bg-[{{ .SecondaryColor }}] truncate"
                > Settings</a>

                <div class="w-full flex gap-3">
                    <a
                        href="/phaddergrupp/{{ .PhaddergruppID }}/stats"
                        class="flex-1 bg-[{{ .PrimaryColor }}] text-brand-primary-content text-center px-6 py-2 rounded-md text-lg font-semibold hover:bg-[{{ .SecondaryColor }}] active:bg-[{{ .SecondaryColor }}] truncate"
                    > Stats</a>
                    <a
                        href="/phaddergrupp/{{ .PhaddergruppID }}/audit"
                        class="flex-1 bg-[{{ .PrimaryColor }}] text-brand-primary-content text-center px-6 py-2 rounded-md text-lg font-semibold hover:bg-[{{ .SecondaryColor }}] active:bg-[{{ .SecondaryColor }}] truncate"
                    > Audit log</a>
                </div>

                {{ template "component-divider" dict "Class" (printf "border-[%s]" .PrimaryColor) }}

                {{ template "fragment-transaction-log" . }}
            {{ end }}
        </div>
    </div>
{{ end }}

{{ define "fragment-group-name" }}
    <h1
        id="group-name"
        sse-swap="phaddergrupp-header-update"
        hx-swap="outerHTML"
        class="text-5xl font-bold break-words max-w-full text-backdrop-content"
    >{{ .PhaddergruppData.Name }}</h1>
{{ end }}

{{ define "fragment-member-lists" }}
    <div
        id="member-lists"
        sse-swap="phaddergrupp-member-lists-update"
        hx-swap="outerHTML"
        class="w-full"
    >
        <div
            sse-swap="mums-available-badge-update"
            hx-swap="none"
            class="flex flex-col gap-3 w-full"
        >
            {{ if .PhaddergruppUserSummaries.N0llor }}
                {{ template "fragment-member-section" dict
                    "PhaddergruppID" .PhaddergruppID
                    "UserSummaries" .PhaddergruppUserSummaries.N0llor
                    "Color" .PrimaryColor
                    "Label" "N0llor"
                }}
            {{ end }}
            {{ if .PhaddergruppUserSummaries.Phaddrar }}
                {{ template "fragment-member-section" dict
                    "PhaddergruppID" .PhaddergruppID
                    "UserSummaries" .PhaddergruppUserSummaries.Phaddrar
                    "Color" .SecondaryColor
                    "Label" "Phaddrar"
                }}
            {{ end }}
        </div>
    </div>
{{ end }}

{{ define "fragment-member-section" }}
    <div>
        <h2 class="text-xs text-center text-backdrop-content-muted">󱞡 {{ .Label }} 󱞣</h2>
        {{ template "fragment-member-list" dict
            "PhaddergruppID" .PhaddergruppID
            "UserSummaries" .UserSummaries
            "Color" .Color
        }}
        <p class="text-xs text-center text-backdrop-content-muted">󱞽 {{ .Label }} 󱞿</p>
    </div>
{{ end }}

{{ define "fragment-member-list" }}
    <ul class="flex flex-col gap-3 w-full">
        {{ $root := . }}
        {{ range $_, $s := .UserSummaries }}
            <li>{{ template "fragment-member-summary-card" dict
                "Color" $root.Color
                "PhaddergruppID" $root.PhaddergruppID
                "MemberSummary" $s
            }}</li>
        {{ end }}
    </ul>
{{ end }}

{{ define "fragment-member-summary-card" }}
    <div
        id="member-summary-card-{{ .MemberSummary.UserAccountID }}"
        class="flex items-center gap-4 w-full min-w-0 p-4
               bg-card rounded-xl shadow-sm border-l-4 border-[{{ .Color }}]
               text-card-content"
    >

        <div class="flex flex-col flex-1 min-w-0 gap-1">
            <div class="flex items-center justify-between gap-1 min-w-0">
                <p class="min-w-0 max-w-full truncate">{{ .MemberSummary.UserProfileName }}</p>
                <span class="flex shrink-0 items-center gap-0.5">
                    <img src="/static/icons/drink.svg" alt="" aria-hidden="true" class="size-3" />
                    {{ template "fragment-mums-recency" dict
                        "UserAccountID" .MemberSummary.UserAccountID
                        "DoOOB" false
                        "LastMumsaAt" .MemberSummary.LastMumsaAt
                    }}
                </span>
            </div>

            <div class="flex items-center justify-between flex-wrap gap-1">
                <button
                    hx-post="/phaddergrupp/{{ .PhaddergruppID }}/kick?user-account-id={{ .MemberSummary.UserAccountID }}"
                    hx-confirm="Are you sure you want to kick {{ .MemberSummary.UserProfileName }} from this phaddergrupp?"
                    hx-swap="delete"
                    hx-target="#member-summary-card-{{ .MemberSummary.UserAccountID }}"
                    class="rounded-full px-4 py-1 bg-error border-2 border-dashed border-error-border shadow-lg hover:bg-error-highlight active:bg-error-highlight"
                    title="Kick user from phaddergrupp"
                >
                    <img src="/static/icons/kick.svg" alt="Kick user" class="size-5 invert" />
                </button>

                {{ template "fragment-mums-available-badge" dict
                    "UserAccountID" .MemberSummary.UserAccountID
                    "DoOOB" false
                    "MumsAvailable" .MemberSummary.MumsAvailable
                }}
            </div>
        </div>

        <div class="flex shrink-0 items-center gap-4">

            {{ template "fragment-adjust-button" dict
                "PhaddergruppID" .PhaddergruppID
                "UserAccountID" .MemberSummary.UserAccountID
                "Delta" 1
                "IconPath" "/static/icons/plus.svg"
                "AltText" "Increment user's mums"
            }}

            {{ template "fragment-adjust-button" dict
                "PhaddergruppID" .PhaddergruppID
                "UserAccountID" .MemberSummary.UserAccountID
                "Delta" -1
                "IconPath" "/static/icons/minus.svg"
                "AltText" "Decrement user's mums"
            }}

        </div>

    </div>
{{ end }}

{{ define "fragment-adjust-button" }}
    <button
        hx-post="/phaddergrupp/{{ .PhaddergruppID }}/mums/adjust?user-account-id={{ .UserAccountID }}&delta={{ .Delta }}"
        hx-swap="none"
        class="touch-manipulation rounded-full shadow-md hover:bg-gray-100 active:bg-gray-100 p-2"
        title="{{ .AltText }}"
    >
        <img src="{{ .IconPath }}" alt="{{ .AltText }}" class="size-12" />
    </button>
{{ end }}

{{ define "fragment-mums-available-badge" }}
    <div class="flex items-center gap-1 text-card-content-highlight" title="User's mums">
        <img src="/static/icons/mums.svg" alt="Mums available" class="size-8" />
        <output
            id="mums-available-badge-{{ .UserAccountID }}"
            {{ if .DoOOB -}} hx-swap-oob="true" {{- end }}
            class="font-bold text-2xl text-right w-[2ch]"
        >{{ .MumsAvailable }}</output>
    </div>
{{ end }}

{{ define "fragment-mums-recency" }}
    <span
        id="mums-recency-{{ .UserAccountID }}"
        {{ if .DoOOB -}} hx-swap-oob="true" {{- end }}
        class="mums-recency w-[3ch] text-center text-[10px] leading-none text-card-content-muted"
        {{ if .LastMumsaAt.Valid }}data-last-mumsa="{{ rfc3339 .LastMumsaAt.Time }}"{{ end }}
    >{{ if .LastMumsaAt.Valid }}{{ relTime .LastMumsaAt.Time }}{{ else }}∞{{ end }}</span>
{{ end }}

{{ define "fragment-mums-available-widget" }}
    <div
        id="mums-available-widget"
        sse-swap="mums-available-widget-update"
        hx-swap="outerHTML"
        class="flex flex-col items-center gap-6"
    >
        <output id="mums-available" class="block text-center text-[clamp(6rem,50vw,12rem)] leading-tight {{ if .MumsCapacityReached }} text-warning {{ else }} text-backdrop-content {{ end }}">
            {{- .MumsAvailable -}}
        </output>

        <div class="flex flex-wrap justify-center gap-4">
            {{ if .HasMumsPurchaseQuantities }}
                <form hx-post="/phaddergrupp/{{ .PhaddergruppID }}/purchase-mums" hx-swap="none" class="flex flex-row text-brand-primary-content">
                    <button type="submit" class="flex justify-center items-center
                               gap-2 bg-[{{ .PrimaryColor }}] p-4 rounded-l-md
                               text-2xl font-semibold hover:bg-[{{ .SecondaryColor }}]
                               active:bg-[{{ .SecondaryColor }}]"
                    >
                        <img src="/static/icons/cart.svg" class="size-6 invert" alt=""/>
                        <span>Buy</span>
                    </button>

                    <label for="mums-purchase-quantity" class="sr-only">Quantity</label>
                    <select id="mums-purchase-quantity" name="mums-purchase-quantity" class="text-center bg-[{{ .SecondaryColor }}] rounded-r-md p-4 text-xl">
                        {{ range .MumsPurchaseQuantities }}
                            <option {{ if eq . $.MumsDefaultPurchaseQuantity }}selected{{ end }}>{{ . }}</option>
                        {{ end }}
                    </select>
                </form>
            {{ end }}

            {{ if .HasMumsAvailable }}
                <button
                    hx-post="/phaddergrupp/{{ .PhaddergruppID }}/mumsa"
                    hx-confirm="Are you sure you want to consume one mums?"
                    class="touch-manipulation flex justify-center items-center gap-3 bg-[{{ .PrimaryColor }}] text-brand-primary-content
                           p-4 rounded-md text-2xl font-semibold hover:bg-[{{ .SecondaryColor }}]
                           active:bg-[{{ .SecondaryColor }}] shadow-md"
                >
                    <img src="/static/icons/drink.svg" class="size-6 invert" alt=""/>
                    <span>Mumsa</span>
                </button>
            {{ end }}

        </div>
    </div>
{{ end }}

{{ define "fragment-invite-link" }}
    <div class="flex flex-col gap-1 w-full">
        <label for="{{ .ID }}" class="block text-sm font-medium text-backdrop-content-muted">
            {{ .Label }}
        </label>
        <input
            id="{{ .ID }}"
            type="text"
            data-url="{{ .URL }}"
            value="{{ .URL }}"
            readonly
            hx-on:click="
                navigator.clipboard.writeText(this.dataset.url)
                    .then(() => {
                        this.value = '- Copied -';
                        const copyStyleAdd = [
                            'text-center',
                            'text-success',
                            'font-semibold',
                            'border-success'
                        ];
                        const copyStyleRemove = [
                            'text-input-content',
                            'border-input-border-muted'
                        ];
                        this.classList.add(...copyStyleAdd);
                        this.classList.remove(...copyStyleRemove);
                        setTimeout(() => {
                            this.value = this.dataset.url;
                            this.classList.remove(...copyStyleAdd);
                            this.classList.add(...copyStyleRemove);
                        }, 1000);
                    })
                    .catch(err => console.error('Failed to copy: ', err))
            "
            class="w-full bg-input text-input-content rounded-md border-2 border-input-border-muted px-3 py-2 text-sm cursor-pointer caret-transparent truncate select-all focus:outline-none"
            title="Click to copy"
        />
    </div>
{{ end }}

{{ define "fragment-transaction-log" }}
    <div
        id="phaddergrupp-transaction-preview"
        sse-swap="phaddergrupp-preview-update"
        hx-swap="outerHTML"
        class="w-full flex flex-col gap-1"
    >
        <h2 class="text-center text-xl font-semibold text-backdrop-content">Latest slurps n' burps (n0llor)</h2>
        {{ if .HasRecentTransactions }}
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs text-backdrop-content-muted">
                        <th class="px-2 py-1 font-normal text-left">Name</th>
                        <th class="px-2 py-1 font-normal text-right"><span class="inline-flex items-center"><span>Δ</span><img src="/static/icons/mums.svg" alt="" aria-hidden="true" class="size-3" /></span></th>
                        <th class="px-2 py-1 font-normal text-right">Δt</th>
                    </tr>
                </thead>
                <tbody class="text-card-content">
                    {{ range .RecentTransactions }}
                        <tr class="odd:bg-card">
                            <td class="px-2 py-1 max-w-[6rem] truncate">{{ .Name }}</td>
                            <td class="px-2 py-1 text-right tabular-nums">{{ if gt .Delta 0 }}+{{ end }}{{ .Delta }}</td>
                            <td class="mums-recency px-2 py-1 text-right text-card-content-muted" data-last-mumsa="{{ rfc3339 .Time }}">{{ relTime .Time }}</td>
                        </tr>
                    {{ end }}
                </tbody>
            </table>
        {{ else }}
            <p class="text-center text-card-content-muted">No transactions yet.</p>
        {{ end }}
    </div>
{{ end }}
