{{ define "base" }}
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>{{ block "title" . }}mums{{ end }}</title>
            <link rel="icon" href="/static/favicon.ico" type="image/x-icon"/>
            <link rel="manifest" href="/static/manifest.webmanifest" />
            <meta name="theme-color" content="#f280a1" />
            <meta name="mobile-web-app-capable" content="yes" />
            <meta name="apple-mobile-web-app-capable" content="yes" />
            <meta name="apple-mobile-web-app-status-bar-style" content="default" />
            <meta name="apple-mobile-web-app-title" content="mums" />
            <link rel="apple-touch-icon" sizes="180x180" href="/static/icons/mums-180.png" />
            {{ template "import-htmx" . }}
            {{ template "import-tailwind" . }}
            <meta name="csrf-token" content="{{ .CSRFToken }}" />
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", (_) => {
                    document.body.addEventListener("htmx:configRequest", function(event) {
                        const meta = document.querySelector('meta[name="csrf-token"]');
                        if (meta) {
                            event.detail.headers["HX-CSRF-Token"] = meta.content;
                        }
                    });
                });
            </script>
            <script type="text/javascript">
                document.cookie = "{{ tzCookieName }}=" + encodeURIComponent(Intl.DateTimeFormat().resolvedOptions().timeZone) + "; Path=/; Max-Age=31536000; SameSite=Lax";
            </script>
            {{ if .AllowedErrorCodes }}
                <script type="text/javascript">
                    document.addEventListener("DOMContentLoaded", (_) => {
                        document.body.addEventListener("htmx:beforeSwap", function(event) {
                            const status = event.detail.xhr.status;
                            if ({{ range $i, $code := .AllowedErrorCodes }} {{ if $i }} || {{ end }} status == {{ $code }} {{ end }}) {
                                event.detail.shouldSwap = true;
                                event.detail.isError = false;
                            }
                        });
                    });
                </script>
            {{ end }}
            {{ block "head" . }}
            {{ end }}
        </head>
        <body class="min-h-screen flex flex-col font-iosevka gap-12">
            <header class="sticky top-0 z-1337 bg-backdrop">
                <nav class="border-b border-backdrop-border">
                    <div class="max-w-7xl mx-auto px-4 sm:px-8 flex justify-between h-16">
                        <div class="shrink-0 flex flex-1 justify-start items-center">
                            <a href="/">
                                <img class="h-10 w-auto" src="/static/icons/mums.svg" alt="Logo" />
                            </a>
                        </div>
                        <ul class="hidden sm:-my-px sm:flex sm:flex-1 justify-center sm:gap-8">
                            <li class="flex">{{ template "component-nav-link" dict "Href" "/" "Text" "Home" }}</li>
                            <li class="flex">{{ template "component-nav-link" dict "Href" "/about" "Text" "About" }}</li>
                        </ul>
                        <ul class="sm:hidden -my-px flex flex-1 justify-center">
                            <li class="flex">{{ template "component-nav-link" dict "Href" "/about" "Text" "- About -" }}</li>
                        </ul>
                        <div class="flex flex-1 items-center justify-end gap-4">
                            {{ if .IsLoggedIn }}
                                <a href="/settings" class="text-sm text-backdrop-content-muted hover:text-backdrop-content active:text-backdrop-content hover:underline active:underline">Account</a>
                                <a hx-post="/logout" href="#" class="text-sm text-backdrop-content-highlight hover:text-backdrop-content-highlight active:text-backdrop-content-highlight hover:underline active:underline">Logout</a>
                            {{ else }}
                                <a href="/login" class="text-sm text-backdrop-content-muted hover:text-backdrop-content active:text-backdrop-content hover:underline active:underline">Login</a>
                                <a href="/register" class="text-sm text-backdrop-content-highlight hover:text-backdrop-content-highlight active:text-backdrop-content-highlight hover:underline active:underline">Register</a>
                            {{ end }}
                        </div>
                    </div>
                </nav>
            </header>
            <main class="flex-1 flex flex-col justify-center max-w-xl w-full mx-auto px-8">
                {{ template "content" . }}
            </main>
            <footer class="bg-footer text-footer-content py-6">
                <div class="max-w-md mx-auto px-4 text-center text-sm flex flex-col gap-3">
                    {{ template "component-external-link" dict
                        "Href" "https://github.com/memagu/mums"
                        "IconPath" "/static/icons/invertocat.svg"
                        "IconClass" "size-5"
                        "Class" "text-footer-content-highlight font-semibold"
                        "Text" "GitHub Repository"
                    }}
                    <p>
                        &copy;&nbsp;2025
                        {{ template "component-external-link" dict
                            "Href" "https://www.mewi.dev"
                            "Class" "text-footer-content-highlight font-semibold"
                            "Text" "Melker Widén"
                        -}}
                        . All rights reserved.
                    </p>
                </div>
            </footer>
            <dialog id="confirm-modal" class="bg-card rounded-xl shadow-lg mx-auto px-8 py-6 max-w-sm top-1/2 -translate-y-1/2 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
                <div class="flex flex-col gap-6">
                <p id="confirm-modal-message" class="text-center text-card-content"></p>
                <div class="flex gap-3">
                    <button
                        id="confirm-modal-cancel"
                        class="flex-1 py-2 rounded-md text-lg font-semibold text-card-content-muted border-2 border-card-border hover:text-card-content active:text-card-content"
                    >Cancel</button>
                    <button
                        id="confirm-modal-confirm"
                        class="flex-1 py-2 rounded-md text-lg font-semibold text-error-content bg-error border-2 border-dashed border-error-border hover:bg-error-highlight active:bg-error-highlight"
                    >Confirm</button>
                </div>
            </dialog>
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                    var dialog = document.getElementById("confirm-modal");
                    var message = document.getElementById("confirm-modal-message");
                    var cancelBtn = document.getElementById("confirm-modal-cancel");
                    var confirmBtn = document.getElementById("confirm-modal-confirm");
                    var pendingRequest = null;

                    cancelBtn.addEventListener("click", function () {
                        dialog.close();
                        pendingRequest = null;
                    });

                    confirmBtn.addEventListener("click", function () {
                        dialog.close();
                        if (pendingRequest) {
                            pendingRequest();
                            pendingRequest = null;
                        }
                    });

                    dialog.addEventListener("click", function (e) {
                        if (e.target === dialog) {
                            dialog.close();
                            pendingRequest = null;
                        }
                    });

                    document.body.addEventListener("htmx:confirm", function (evt) {
                        if (!evt.detail.target.hasAttribute("hx-confirm")) return;

                        evt.preventDefault();

                        message.textContent = evt.detail.question;
                        pendingRequest = function () {
                            evt.detail.issueRequest(true);
                        };
                        dialog.showModal();
                    });
                });
            </script>
            <script type="text/javascript">
                if ("serviceWorker" in navigator) {
                    navigator.serviceWorker.register("/sw.js");
                }
            </script>
        </body>
    </html>
{{ end }}
