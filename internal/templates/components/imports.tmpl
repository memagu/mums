{{ define "import-htmx" }}
    <script
        src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
        integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
        crossorigin="anonymous"
    ></script>
{{ end }}

{{ define "import-tailwind" }}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
    <style type="text/tailwindcss">
        @theme {
            --brand-pink: #f280a1;
            --brand-purple: #9966cc;

            --color-brand-primary: var(--brand-pink);
            --color-brand-primary-content: var(--color-white);
            --color-brand-secondary: var(--brand-purple);
            --color-brand-secondary-content: var(--color-white);

            --color-backdrop: var(--color-amber-50);
            --color-backdrop-content: var(--color-gray-900);
            --color-backdrop-content-muted: var(--color-gray-600);
            --color-backdrop-content-highlight: var(--color-indigo-600);
            --color-backdrop-border: var(--color-gray-200);

            --color-card: var(--color-white);
            --color-card-content: var(--color-gray-900);
            --color-card-content-muted: var(--color-gray-600);
            --color-card-content-highlight: var(--color-indigo-600);
            --color-card-border: var(--color-gray-200);

            --color-input: var(--color-white);
            --color-input-content: var(--color-gray-900);
            --color-input-content-muted: var(--color-gray-400);
            --color-input-border: var(--brand-purple);
            --color-input-border-muted: var(--color-gray-300);

            --color-footer: var(--color-slate-900);
            --color-footer-content: var(--color-gray-300);
            --color-footer-content-highlight: var(--color-blue-400);

            --color-error: var(--color-red-600);
            --color-error-content: var(--color-white);
            --color-error-highlight: var(--color-red-700);
            --color-error-border: var(--color-yellow-400);
            --color-warning: var(--color-red-700);
            --color-success: var(--color-green-600);

            --font-iosevka: "Iosevka Nerd Font Mono", monospace;
        }

        @font-face {
            font-family: "Iosevka Nerd Font Mono";
            src:
                url("/static/fonts/iosevka/IosevkaNerdFontMono-Regular.woff2") format("woff2"),
                url("/static/fonts/iosevka/IosevkaNerdFontMono-Regular.ttf") format("truetype");
            font-weight: 400;
            font-style: normal;
            font-display: swap;
            font-feature-settings: "calt" 0;
        }

        @layer base {
            html {
                background-color: var(--color-backdrop);
            }

            input[type="password"] {
                font-family: sans-serif;
            }
        }
    </style>
{{ end }}

{{ define "import-htmx-sse" }}
    <script
        src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4"
        integrity="sha384-A986SAtodyH8eg8x8irJnYUk7i9inVQqYigD6qZ9evobksGNIXfeFvDwLSHcp31N"
        crossorigin="anonymous"
    ></script>
{{ end }}

{{ define "import-toastr" }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
{{ end }}
