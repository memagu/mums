# Omit a variable to use its default value.

# Server
MUMS_ADDRESS=:11337
MUMS_APP_URL=http://127.0.0.1:11337
MUMS_COOKIE_SECURE=true
MUMS_IDLE_TIMEOUT=120s
MUMS_READ_HEADER_TIMEOUT=10s
MUMS_SSE_TIMEOUT=666s

# Database
MUMS_DB_PATH=mums.sqlite3
MUMS_DB_BUSY_TIMEOUT=5s

# Auth
MUMS_SESSION_TTL=1337h
MUMS_SESSION_TOKEN_SIZE=32
MUMS_SESSION_COOKIE=sessionToken
MUMS_SESSION_CLEANUP=666s
MUMS_INVITE_TOKEN_SIZE=32

# Swish
MUMS_SWISH_NUMBER_PATTERN=^(\+46 ?(\(0\))?|0) ?7[02369]-?\d{3} ?\d{2} ?\d{2}$
